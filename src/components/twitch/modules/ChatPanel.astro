---
interface ChatMessage {
  user: string;
  color?: string;
  message: string;
}

interface Props {
  messages: ChatMessage[] | null;
}
// ❗ Props aus Astro holen
const { messages } = Astro.props;
const hasData = Array.isArray(messages) && messages.length > 0;
---

<section class="card p-6 flex flex-col gap-4">
  <h3 class="text-xl font-semibold text-[#F5F7FA]">
    Twitch Chat — Live Feed
  </h3>

  <div
    id="chatWindow"
    class="h-64 overflow-auto flex flex-col gap-3 bg-[#1F2933] border border-[rgba(255,255,255,0.06)] rounded-lg p-3 font-mono text-sm"
  >
    {hasData ? (
      messages!.map((m) => (
        <div class="flex gap-2">
          <span style={`color: ${m.color || "#FF8C1A"}`} class="font-bold">
            {m.user}:
          </span>
          <span class="text-[#D1D5DB]">{m.message}</span>
        </div>
      ))
    ) : (
      <p class="text-[#9AA5B1] text-center">Chat-Feed nicht verfügbar. Besuche den Stream auf Twitch!</p>
    )}
  </div>

  <script>
    const chatWindow = document.getElementById("chatWindow");

    // Auto-scroll
    function scroll() {
      if (chatWindow) {
        chatWindow.scrollTop = chatWindow.scrollHeight;
      }
    }

    // WebSocket Connection
    const wsUrl = "wss://api.intern.phudevelopement.xyz/ws";
    let ws = null;

    function connectWebSocket() {
      try {
        ws = new WebSocket(wsUrl);

        ws.onopen = () => {
          console.log("✅ WebSocket connected");
          // Send ready signal
          ws.send(JSON.stringify({ type: "overlay:ready" }));
        };

        ws.onmessage = (event) => {
          try {
            const data = JSON.parse(event.data);

            // Handle Twitch chat messages
            if (data.type === "twitch:chat") {
              addChatMessage(data.payload);
            }
          } catch (e) {
            console.error("Failed to parse WebSocket message:", e);
          }
        };

        ws.onerror = (error) => {
          console.error("WebSocket error:", error);
        };

        ws.onclose = () => {
          console.log("WebSocket disconnected. Reconnecting in 5s...");
          setTimeout(connectWebSocket, 5000);
        };
      } catch (e) {
        console.error("Failed to connect WebSocket:", e);
      }
    }

    function addChatMessage(msg) {
      if (!chatWindow) return;

      // Clear "not available" message if present
      const placeholder = chatWindow.querySelector("p");
      if (placeholder) {
        placeholder.remove();
      }

      const line = document.createElement("div");
      line.className = "flex gap-2";

      const user = document.createElement("span");
      user.textContent = (msg.user || msg.username || "User") + ":";
      user.style.color = msg.color || "#FF8C1A";
      user.className = "font-bold";

      const text = document.createElement("span");
      text.textContent = msg.message || msg.text || "";
      text.className = "text-[#D1D5DB]";

      line.appendChild(user);
      line.appendChild(text);

      chatWindow.appendChild(line);

      // Limit to last 50 messages
      const messages = chatWindow.querySelectorAll(".flex.gap-2");
      if (messages.length > 50) {
        messages[0].remove();
      }

      scroll();
    }

    // Start WebSocket connection
    connectWebSocket();
  </script>
</section>
