---
interface Follower {
  user_id: string;
  user_login: string;
  user_name: string;
  followed_at: string;
}

interface Props {
  followers: { followers: Follower[] } | null;
}

const { followers } = Astro.props;

const followerList = followers?.followers ?? [];
const hasData = Array.isArray(followerList) && followerList.length > 0;
---

<section class="card p-6 flex flex-col gap-4">
  <h3 class="text-xl font-semibold text-[#F5F7FA]">
    Neueste Follower
  </h3>

  {hasData ? (
    <ul class="flex flex-col gap-4">
      {followerList.slice(0, 5).map((follower) => (
        <li class="flex items-center gap-4">
          <img
            src={`https://static-cdn.jtvnw.net/user-default-pictures-uv/cdd517fe-def4-11e9-948e-784f43822e80-profile_image-70x70.png`}
            class="w-10 h-10 rounded-full border border-[#FF8C1A] object-cover"
            alt={follower.user_name}
          />
          <div class="flex flex-col">
            <span class="font-semibold text-[#F5F7FA]">{follower.user_name}</span>
            <span class="text-xs text-[#9AA5B1]">
              {new Date(follower.followed_at).toLocaleString('de-DE')}
            </span>
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="text-[#9AA5B1] text-sm">Keine Follower-Daten geladen.</p>
  )}
</section>
