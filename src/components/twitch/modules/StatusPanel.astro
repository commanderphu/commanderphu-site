---
const { status, isLive = false, viewerCount = 0, user } = Astro.props;
---
<div class="card p-6 flex flex-col gap-4">
  <div class="flex items-center gap-4">

    <img
      src={user?.avatar ?? "https://static-cdn.jtvnw.net/user-default-pictures-uv/cdd517fe-def4-11e9-948e-784f43822e80-profile_image-300x300.png"}
      alt="Avatar"
      class="w-16 h-16 rounded-full border-2 border-[#FF8C1A] object-cover"
    />

    <div>
      <h2 class="text-2xl font-semibold text-[#F5F7FA]">
        {user?.display_name ?? "CommanderPhu"}
      </h2>

      {isLive ? (
        <span class="px-3 py-1 bg-red-500/20 text-red-400 border border-red-500/40 rounded-md text-sm mt-1">
          🔴 LIVE
        </span>
      ) : (
        <span class="px-3 py-1 bg-gray-500/30 text-gray-300 border border-gray-500/40 rounded-md text-sm mt-1">
          ⚫ OFFLINE
        </span>
      )}
    </div>
  </div>

  {isLive && (
    <>
      <p class="text-lg font-semibold mt-2 text-[#F5F7FA]">{status?.title}</p>

      <p class="text-[#D1D5DB] text-sm">
        <strong class="text-[#F5F7FA]">Kategorie:</strong> {status?.gameName ?? status?.game_name}
      </p>

      <p class="text-[#D1D5DB] text-sm">
        <strong class="text-[#F5F7FA]">Zuschauer:</strong> {viewerCount}
      </p>
    </>
  )}
</div>
