---
const links = [
  { name: "Home", href: "/" },
  { name: "Twitch", href: "/twitch" },
  { name: "Commands", href: "/commands" },
];
---

<nav class="w-full fixed top-0 left-0 z-50 backdrop-blur-md bg-[#1F2933]/90 border-b border-[rgba(255,255,255,0.06)]">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Brand -->
    <a href="/" class="text-[#F5F7FA] text-lg font-semibold tracking-wide uppercase" style="font-family: 'Orbitron', sans-serif; letter-spacing: 0.08em;">
      CommanderPhu
    </a>

    <!-- Links -->
    <ul class="flex items-center gap-8 text-[#D1D5DB]">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="hover:text-[#FF8C1A] transition-colors text-sm uppercase tracking-wide"
          >
            {link.name}
          </a>
        </li>
      ))}
    </ul>

  </div>
</nav>
